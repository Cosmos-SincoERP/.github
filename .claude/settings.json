{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(gh auth status)",
      "Bash(gh api:*)",
      "Bash(gh repo:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(gh label:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh workflow:*)",
      "Bash(gh run:*)",
      "Bash(gh release:*)",
      "Bash(gh browse:*)",
      "Bash(gh search:*)",
      "Bash(gh extension:*)",
      "Bash(git:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",
      "Bash(pinact:*)",
      "Bash(ratchet:*)",
      "Bash(gitleaks:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(base64:*)",
      "Bash(curl:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(diff:*)"
    ],
    "deny": [
      "Bash(gh secret:*)",
      "Bash(gh api*orgs/*/actions/secrets/*)",
      "Bash(gh api*orgs/*/dependabot/secrets/*)",
      "Bash(gh api*orgs/*/codespaces/secrets/*)",
      "Bash(gh api*repos/*/actions/secrets/*)",
      "Bash(gh api*repos/*/dependabot/secrets/*)",
      "Bash(gh api*repos/*/codespaces/secrets/*)",
      "Bash(gh api*orgs/*/actions/variables/*)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)"
    ]
  }
}
